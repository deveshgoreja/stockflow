# Copy to .env. These are local development values only; never commit real secrets.

# Used by the Postgres container in compose.yaml
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow

# Used when running the API or Alembic directly on your machine.
# (Inside Docker Compose the API connects to the `db` service instead.)
DATABASE_URL=postgresql+psycopg://stockflow:stockflow@localhost:5432/stockflow

# Used by pytest. Tests DROP and recreate this database's schema, so it must be
# a dedicated database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://stockflow:stockflow@localhost:5432/stockflow_test

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Where the dashboard sends API requests.
VITE_API_URL=http://localhost:8000
